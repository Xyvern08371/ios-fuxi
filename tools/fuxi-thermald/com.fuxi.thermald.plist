<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.fuxi.thermald</string>
    <key>ProgramArguments</key><array><string>/usr/local/bin/thermald</string></array>
    <key>UserName</key><string>root</string>
    <key>RunAtLoad</key><true/>
    <!-- No respawn loop when fuxitp=1 is absent. -->
    <key>KeepAlive</key><false/>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>/dev/console</string>
    <key>StandardErrorPath</key><string>/dev/console</string>
</dict>
</plist>
